{"$schema": "https://biomejs.dev/schemas/2.0.6/schema.json", "organizeImports": {"enabled": true}, "linter": {"enabled": true, "rules": {"recommended": true, "suspicious": {"noExplicitAny": "error", "noFallthroughSwitchClause": "error"}, "style": {"noDefaultExport": "error", "useImportType": "error", "noNonNullAssertion": "error", "noParameterAssign": "error"}, "correctness": {"noUnusedVariables": "error", "noUnusedImports": "error"}}}, "formatter": {"enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 100}, "javascript": {"formatter": {"quoteStyle": "double", "semicolons": "asNeeded"}}, "files": {"ignore": ["node_modules", "dist", "build", "coverage"]}}